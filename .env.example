# Bento — variáveis de ambiente (copie para .env.local; NUNCA commite valores reais)

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publicável (pública; protegida pela RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Chave secreta — SOMENTE servidor. Usada apenas para criar a conta no aceite de convite
# e no script bootstrap:admin. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxx

# URL canônica do app (links de convite e redirecionamentos de Auth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sal para o hash anônimo anti-spam do feedback público (qualquer texto longo e aleatório)
FEEDBACK_HASH_SALT=troque-por-um-valor-aleatorio

# Opcional: slug da organização exibida no portal público
# PORTAL_ORG_SLUG=entomo-agro-360
